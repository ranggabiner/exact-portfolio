test "the welcome speaks the language the person picks"
  epoch "2026-11-27T03:00:00Z"
  time-zone "Asia/Jakarta"
  expect text "welcome-title" == "Your mind, clear."
  tap "lang-id"
  expect text "welcome-title" == "Pikiran jadi lega."

test "answers are used: the quiz, the smart capture demo, the plan and the first tasks"
  epoch "2026-11-27T03:00:00Z"
  time-zone "Asia/Jakarta"
  tap "ob-next"
  tap "ob-next"
  tap "ob-next"
  tap "ob-next"
  type "name" "Rangga"
  expect tree has "fact"
  tap "ob-next"
  tap "role-founder"
  tap "ob-next"
  tap "struggle-overwhelm"
  tap "struggle-starting"
  tap "ob-next"
  tap "area-money"
  tap "ob-next"
  tap "peak-morning"
  tap "ob-next"
  tap "ob-next"
  type "capacity" "4"
  expect text "capacity-value" == "4"
  tap "ob-next"
  tap "focus-45"
  tap "ob-next"
  tap "capture-dump"
  tap "ob-next"
  tap "reminders-none"
  tap "ob-next"
  tap "celebrate-calm"
  tap "ob-next"
  tap "weekly-sunday"
  tap "ob-next"
  type "first" "Send the report today"
  tap "ob-next"
  tap "demo-example"
  clock data
  expect text "demo-sorted" == "Sorted on your iPhone"
  expect tree has "demo-draft-2"
  tap "ob-next"
  tap "ob-next"
  tap "ob-next"
  clock +2000
  expect tree has "plan-summary"
  expect state pFocus == 45
  tap "ob-next"
  tap "icon-1"
  expect state iconPick == "Midnight"
  tap "ob-next"
  expect text "ob-next-label" == "Open Lumen"
  tap "ob-next"
  clock data
  clock +1000
  clock data
  expect state onboarded == true
  expect text "greeting" == "Good morning, Rangga"
  expect text "headline" == "1 task for today"
  reload
  clock data
  expect state onboarded == true
  expect text "greeting" == "Good morning, Rangga"

